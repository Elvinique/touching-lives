---
import { MonitorPlay, Camera, ThumbsUp, Music2, X } from '@lucide/astro';
import { site } from '@/config/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// Only networks with a configured URL are rendered — never fake accounts.
// Brand logos were removed from Lucide, so each network uses a tasteful generic mark.
const links = [
  { name: 'YouTube', href: site.social.youtube, icon: MonitorPlay },
  { name: 'Instagram', href: site.social.instagram, icon: Camera },
  { name: 'Facebook', href: site.social.facebook, icon: ThumbsUp },
  { name: 'TikTok', href: site.social.tiktok, icon: Music2 },
  { name: 'X (Twitter)', href: site.social.x, icon: X },
].filter((link) => link.href !== '');
---

{links.length > 0 && (
  <ul class={`flex items-center gap-2.5 ${className ?? ''}`}>
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${site.shortName} on ${link.name}`}
            class="flex h-10 w-10 items-center justify-center rounded-full border border-cream/15 text-cream/80 transition-all duration-300 hover:-translate-y-0.5 hover:border-terra-400 hover:bg-terra-500 hover:text-white"
          >
            <link.icon class="h-[18px] w-[18px]" aria-hidden="true" />
          </a>
        </li>
      ))
    }
  </ul>
)}

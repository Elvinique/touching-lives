---
import { site } from '@/config/site';
import { Send } from '@lucide/astro';

const endpoint = site.forms.newsletterEndpoint;
---

<div class="rounded-3xl border border-cream/10 bg-cream/5 p-6">
  <h2 class="font-display text-lg text-cream">Staying in the loop</h2>
  <p class="mt-1.5 text-sm text-cream/60">
    One short email a month — what's happening, what's coming, and how to be part of it.
  </p>

  <form class="mt-4" data-newsletter-form data-endpoint={endpoint} novalidate>
    <div class="flex flex-col gap-2 sm:flex-row">
      <label class="sr-only" for="newsletter-email">Email address</label>
      <input
        id="newsletter-email"
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder="you@example.com"
        class="w-full flex-1 rounded-full border border-cream/15 bg-pine-950/60 px-5 py-3 text-sm text-cream placeholder:text-cream/35 transition-colors focus:border-terra-400 focus:outline-none focus:ring-4 focus:ring-terra-500/20"
      />
      <button type="submit" class="btn btn-primary btn-md" data-submit>
        Subscribe
        <Send class="h-4 w-4" aria-hidden="true" />
      </button>
    </div>
    <p class="error hidden" data-error-for="email" role="alert"></p>
    <div class="hidden" data-status role="status"></div>
  </form>
</div>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-newsletter-form]');
  if (form) {
    const emailInput = form.querySelector<HTMLInputElement>('[name="email"]');
    const errorEl = form.querySelector<HTMLElement>('[data-error-for="email"]');
    const statusEl = form.querySelector<HTMLElement>('[data-status]');
    const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit]');
    const originalBtnHtml = submitBtn ? submitBtn.innerHTML : '';
    const ENDPOINT = form.dataset.endpoint || '';

    const setError = (message: string | null) => {
      if (!errorEl || !emailInput) return;
      errorEl.textContent = message ?? '';
      errorEl.classList.toggle('hidden', !message);
      emailInput.setAttribute('aria-invalid', message ? 'true' : 'false');
    };

    const showStatus = (html: string, kind: 'success' | 'info' | 'error') => {
      if (!statusEl) return;
      statusEl.className = `status-${kind}`;
      statusEl.innerHTML = html;
      statusEl.classList.remove('hidden');
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!emailInput || !submitBtn) return;
      const value = emailInput.value.trim();
      if (!value) {
        setError('Please enter your email address.');
        emailInput.focus();
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
        setError('That doesn’t look like a valid email address.');
        emailInput.focus();
        return;
      }
      setError(null);

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';

      try {
        if (ENDPOINT) {
          const res = await fetch(ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ email: value }),
          });
          if (!res.ok) throw new Error('Request failed');
          showStatus('✅ <strong>You’re in!</strong> Watch your inbox for our next email.', 'success');
          form.hidden = true;
        } else {
          showStatus(
            '📬 <strong>Thanks for signing up!</strong> <span class="opacity-80">This form isn’t connected to a live list yet — set the <code>PUBLIC_NEWSLETTER_ENDPOINT</code> environment variable to deliver signups.</span>',
            'info',
          );
        }
      } catch {
        showStatus('Something went wrong — please try again in a moment.', 'error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalBtnHtml;
      }
    });
  }
</script>

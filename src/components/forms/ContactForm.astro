---
import { site } from '@/config/site';
import { Send } from '@lucide/astro';

const endpoint = site.forms.contactEndpoint;

const topics = ['General question', 'Planning my first visit', 'Kids or student ministries', 'Baptism or membership', 'Serve or volunteer', 'Something else'];
---

<form class="grid gap-5" data-contact-form data-endpoint={endpoint} novalidate>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label class="label" for="contact-name">Your name</label>
      <input id="contact-name" name="name" type="text" autocomplete="name" required minlength="2" class="input" />
      <p class="error" data-error-for="name" hidden></p>
    </div>
    <div>
      <label class="label" for="contact-email">Email</label>
      <input id="contact-email" name="email" type="email" autocomplete="email" required class="input" />
      <p class="error" data-error-for="email" hidden></p>
    </div>
  </div>

  <div>
    <label class="label" for="contact-topic">What's this about?</label>
    <div class="select-wrap">
      <select id="contact-topic" name="topic" class="input" required>
        {
          topics.map((topic) => <option value={topic}>{topic}</option>)
        }
      </select>
    </div>
    <p class="error" data-error-for="topic" hidden></p>
  </div>

  <div>
    <label class="label" for="contact-message">Message</label>
    <textarea id="contact-message" name="message" rows="5" required minlength="10" class="input resize-y"></textarea>
    <p class="error" data-error-for="message" hidden></p>
  </div>

  <div>
    <button type="submit" class="btn btn-primary btn-lg" data-submit>
      Send message
      <Send class="h-4 w-4" aria-hidden="true" />
    </button>
  </div>

  <div class="hidden" data-status role="status"></div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const ENDPOINT = form.dataset.endpoint || '';
    const statusEl = form.querySelector<HTMLElement>('[data-status]');
    const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit]');
    const originalBtnHtml = submitBtn ? submitBtn.innerHTML : '';
    const inputs = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('[required]'));

    const setError = (input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement, message: string | null) => {
      const errorEl = form.querySelector<HTMLElement>(`[data-error-for="${input.name}"]`);
      if (!errorEl) return;
      const id = `${input.name}-error`;
      errorEl.id = id;
      errorEl.textContent = message ?? '';
      errorEl.hidden = !message;
      input.setAttribute('aria-invalid', message ? 'true' : 'false');
      input.setAttribute('aria-describedby', message ? id : '');
    };

    const validate = (): boolean => {
      let valid = true;
      for (const input of inputs) {
        const value = (input.value || '').trim();
        let message: string | null = null;
        if (!value) {
          message = 'This field is required.';
        } else if (input.type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
          message = 'Please enter a valid email address.';
        } else if (input instanceof HTMLTextAreaElement && value.length < 10) {
          message = 'Please write a little more (at least 10 characters).';
        }
        if (message) valid = false;
        setError(input, message);
      }
      return valid;
    };

    const showStatus = (html: string, kind: 'success' | 'info' | 'error') => {
      if (!statusEl) return;
      statusEl.className = `status-${kind}`;
      statusEl.innerHTML = html;
      statusEl.classList.remove('hidden');
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!validate() || !submitBtn) return;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';

      try {
        if (ENDPOINT) {
          const res = await fetch(ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
          });
          if (!res.ok) throw new Error('Request failed');
          showStatus('📬 <strong>Message received!</strong> We’ll get back to you within a couple of days.', 'success');
        } else {
          showStatus(
            '📬 <strong>Your message is ready to send.</strong> <span class="opacity-80">This form isn’t connected to a live inbox yet: set the <code>PUBLIC_CONTACT_ENDPOINT</code> environment variable to deliver messages.</span>',
            'info',
          );
        }
        form.hidden = true;
      } catch {
        showStatus('Something went wrong — please try again in a moment.', 'error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalBtnHtml;
      }
    });

    for (const input of inputs) {
      input.addEventListener('input', () => setError(input, null));
    }
  }
</script>

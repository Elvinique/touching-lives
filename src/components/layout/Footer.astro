---
import { site, footerNav } from '@/config/site';
import { MapPin, Phone, Mail, Clock3, Heart } from '@lucide/astro';
import Logo from '@/components/ui/Logo.astro';
import SocialLinks from '@/components/ui/SocialLinks.astro';
import NewsletterForm from '@/components/forms/NewsletterForm.astro';

const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-pine-950 text-cream">
  <!-- decorative glow -->
  <div class="pointer-events-none absolute -right-40 -top-40 h-[34rem] w-[34rem] rounded-full bg-terra-500/10 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-48 -left-32 h-[30rem] w-[30rem] rounded-full bg-gold-400/10 blur-3xl" aria-hidden="true"></div>

  <div class="wrap relative grid gap-12 py-16 lg:grid-cols-12 lg:py-20">
    <div class="lg:col-span-5 xl:col-span-4">
      <Logo />
      <p class="mt-5 max-w-sm text-pretty text-sm leading-relaxed text-cream/65">
        {site.description}
      </p>
      <div class="mt-6">
        <SocialLinks />
      </div>
      <div class="mt-8">
        <NewsletterForm />
      </div>
    </div>

    <div class="grid gap-10 sm:grid-cols-3 lg:col-span-7 xl:col-span-8">
      <nav aria-label="Plan a visit">
        <h2 class="text-xs font-semibold uppercase tracking-[0.22em] text-gold-300">Visit</h2>
        <ul class="mt-5 space-y-3 text-sm">
          {
            footerNav.visit.map((item) => (
              <li>
                <a href={item.href} class="text-cream/70 transition-colors hover:text-cream">{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Connect">
        <h2 class="text-xs font-semibold uppercase tracking-[0.22em] text-gold-300">Connect</h2>
        <ul class="mt-5 space-y-3 text-sm">
          {
            footerNav.connect.map((item) => (
              <li>
                <a href={item.href} class="text-cream/70 transition-colors hover:text-cream">{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="text-xs font-semibold uppercase tracking-[0.22em] text-gold-300">Find us</h2>
        <address class="mt-5 space-y-3 text-sm not-italic text-cream/70">
          <p class="flex items-start gap-3">
            <MapPin class="mt-0.5 h-4 w-4 shrink-0 text-terra-400" aria-hidden="true" />
            {site.address.street}
            <br />
            {site.address.city}, {site.address.state} {site.address.zip}
          </p>
          <p class="flex items-center gap-3">
            <Clock3 class="h-4 w-4 shrink-0 text-terra-400" aria-hidden="true" />
            Sundays {site.serviceTimes.map((t) => t.label).join(' & ')}
          </p>
          <p>
            <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`} class="flex items-center gap-3 transition-colors hover:text-cream">
              <Phone class="h-4 w-4 shrink-0 text-terra-400" aria-hidden="true" />
              {site.phone}
            </a>
          </p>
          <p>
            <a href={`mailto:${site.email}`} class="flex items-center gap-3 break-all transition-colors hover:text-cream">
              <Mail class="h-4 w-4 shrink-0 text-terra-400" aria-hidden="true" />
              {site.email}
            </a>
          </p>
        </address>
      </div>
    </div>
  </div>

  <div class="relative border-t border-cream/10">
    <div class="wrap flex flex-col items-center justify-between gap-3 py-6 text-xs text-cream/65 sm:flex-row">
      <p>© {year} {site.legalName}. All rights reserved.</p>
      <p class="flex items-center gap-1.5">
        Made with
        <Heart class="h-3.5 w-3.5 fill-terra-500 text-terra-500" aria-hidden="true" />
        in {site.address.city}
      </p>
    </div>
  </div>
</footer>

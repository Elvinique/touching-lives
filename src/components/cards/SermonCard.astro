---
import { Play, User, CalendarDays, BookOpen, Clock3, ArrowRight } from '@lucide/astro';
import { formatShortDate } from '@/lib/dates';

export interface SermonCardData {
  title: string;
  series: string;
  speaker: string;
  date: Date;
  scripture?: string;
  duration?: string;
  description: string;
  image: string;
  href: string;
  videoUrl?: string;
}

interface Props {
  sermon: SermonCardData;
  /** Render the play button as a link out to the video (when videoUrl exists) */
  playable?: boolean;
  class?: string;
}

const { sermon, playable = true, class: className } = Astro.props;
const playHref = playable && sermon.videoUrl ? sermon.videoUrl : sermon.href;
const actionLabel = sermon.videoUrl ? 'Watch' : 'Read';
---

<a
  href={playHref}
  class={`group relative flex flex-col overflow-hidden rounded-[1.4rem] bg-white shadow-soft transition-all duration-300 hover:-translate-y-1.5 hover:shadow-lift ${className ?? ''}`}
  aria-label={`${actionLabel} ${sermon.title}`}
>
  <div class="relative aspect-[3/2] overflow-hidden">
    <img
      src={sermon.image}
      alt=""
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-pine-950/85 via-pine-950/15 to-transparent" aria-hidden="true"></div>

    <span class="chip chip-gold absolute left-4 top-4">{sermon.series}</span>

    <span
      class="absolute bottom-4 left-4 flex h-12 w-12 items-center justify-center rounded-full bg-terra-500 text-white shadow-glow transition-transform duration-300 group-hover:scale-110"
      aria-hidden="true"
    >
      <Play class="ml-0.5 h-5 w-5 fill-current" />
    </span>

    {
      sermon.duration && (
        <span class="chip chip-dark absolute bottom-4 right-4">
          <Clock3 class="h-3 w-3" aria-hidden="true" />
          {sermon.duration}
        </span>
      )
    }
  </div>

  <div class="flex flex-1 flex-col gap-3 p-6">
    <h3 class="font-display text-xl leading-snug text-ink transition-colors group-hover:text-terra-700">
      {sermon.title}
    </h3>
    <p class="meta">
      <span><User aria-hidden="true" />{sermon.speaker}</span>
      <span><CalendarDays aria-hidden="true" />{formatShortDate(sermon.date)}</span>
      {sermon.scripture && (
        <span><BookOpen aria-hidden="true" />{sermon.scripture}</span>
      )}
    </p>
    <p class="line-clamp-2 text-pretty text-sm leading-relaxed text-muted">{sermon.description}</p>
    <span class="card-link">
      {sermon.videoUrl ? 'Watch message' : 'Read message'}
      <ArrowRight aria-hidden="true" />
    </span>
  </div>
</a>

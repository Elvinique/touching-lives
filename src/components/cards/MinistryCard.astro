---
import { ArrowRight, Users } from '@lucide/astro';

export interface MinistryCardData {
  title: string;
  tagline: string;
  audience: string;
  image: string;
  href: string;
}

interface Props {
  ministry: MinistryCardData;
  /** Accent color class for the card CTA (from the existing palette). */
  accent?: string;
}

const { ministry, accent } = Astro.props;
const accentClass = accent ?? 'text-gold-300';
---

<a
  href={ministry.href}
  class="group relative flex flex-col overflow-hidden rounded-[1.4rem] shadow-soft transition-all duration-300 hover:-translate-y-1.5 hover:shadow-lift"
>
  <div class="relative aspect-[4/3] overflow-hidden">
    <img
      src={ministry.image}
      alt=""
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-pine-950/90 via-pine-950/30 to-transparent" aria-hidden="true"></div>
    <span class="chip chip-cream absolute left-4 top-4">
      <Users class="h-3 w-3" aria-hidden="true" />
      {ministry.audience}
    </span>

    <div class="absolute inset-x-0 bottom-0 p-5">
      <h3 class="font-display text-2xl text-cream">{ministry.title}</h3>
      <p class="mt-1 text-pretty text-sm leading-relaxed text-cream/80">{ministry.tagline}</p>
      <span class={`mt-3 inline-flex items-center gap-1.5 text-sm font-semibold ${accentClass}`}>
        Learn more
        <ArrowRight class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true" />
      </span>
    </div>
  </div>
</a>

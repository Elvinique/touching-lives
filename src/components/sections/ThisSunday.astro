---
import { site } from '@/config/site';
import { getNextSunday, formatLongDate, formatDay, formatMonth } from '@/lib/dates';
import { MapPin, CalendarDays, ArrowRight } from '@lucide/astro';
import { media } from '@/data/media';

const nextSunday = getNextSunday();
---

<section id="this-sunday" class="wrap py-16 lg:py-24">
  <div class="reveal relative overflow-hidden rounded-[2rem] bg-pine-950 shadow-lift">
    <img
      src={media.visitWorship.src}
      alt=""
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover opacity-20"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-pine-950 via-pine-950/80 to-pine-950/40" aria-hidden="true"></div>

    <div class="relative grid gap-10 p-8 text-cream sm:p-10 lg:grid-cols-[auto_1fr_auto] lg:items-center lg:gap-12 lg:p-14">
      <!-- Date block -->
      <div class="flex items-center gap-5">
        <div class="flex h-24 w-24 shrink-0 flex-col items-center justify-center rounded-3xl border border-cream/15 bg-cream/10 ring-1 ring-gold-300/30 backdrop-blur-sm">
          <span class="text-xs font-bold uppercase tracking-widest text-gold-300">{formatMonth(nextSunday)}</span>
          <span class="font-display text-5xl font-semibold leading-none">{formatDay(nextSunday)}</span>
        </div>
        <div>
          <p class="kicker text-gold-300">
            <span class="h-1.5 w-1.5 rounded-full bg-current" aria-hidden="true" />
            This Sunday
          </p>
          <h2 class="mt-3 font-display text-2xl text-balance sm:text-3xl">
            {formatLongDate(nextSunday)}
          </h2>
          <p class="mt-2 text-sm text-cream/60">We gather every Sunday — same time, same place, new faces welcome.</p>
        </div>
      </div>

      <!-- Service times -->
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
        {
          site.serviceTimes.map((time) => (
            <li class="flex items-center gap-4 rounded-2xl border border-cream/12 bg-cream/5 px-5 py-4 backdrop-blur-sm transition-colors hover:border-gold-300/40">
              <span class="font-display text-3xl font-semibold text-gold-300">{time.label}</span>
              <span class="text-sm text-cream/70">{time.note}</span>
            </li>
          ))
        }
      </ul>

      <!-- Location + actions -->
      <div class="flex flex-col items-start gap-5 lg:max-w-xs">
        <p class="flex items-start gap-3 text-sm leading-relaxed text-cream/75">
          <MapPin class="mt-0.5 h-5 w-5 shrink-0 text-terra-400" aria-hidden="true" />
          <span>
            {site.address.street}
            <br />
            {site.address.city}, {site.address.state} {site.address.zip}
          </span>
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/visit" class="btn btn-primary btn-md">
            Plan Your Visit
            <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
          <a href={site.mapUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline-light btn-md">
            <CalendarDays class="h-4 w-4" aria-hidden="true" />
            Get Directions
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Reveal from '@/components/ui/Reveal.astro';
import { HeartHandshake, Quote } from '@lucide/astro';
import { media } from '@/data/media';
---

<section class="wrap py-16 lg:py-24">
  <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <!-- Copy -->
    <div>
      <SectionHeading
        kicker="Prayer"
        title="Need prayer? You don't have to walk through it alone."
        lede="Whatever you're carrying tonight — a worry, a decision, a heartbreak, a hope — our prayer team would count it an honor to stand with you. Everything you share stays between you and the team."
      />

      <Reveal delay={120}>
        <figure class="mt-8 rounded-3xl border border-line bg-white p-7 shadow-soft">
          <Quote class="h-7 w-7 text-terra-400" aria-hidden="true" />
          <blockquote class="mt-3 font-display text-xl leading-relaxed text-pine-900">
            "We've prayed for hundreds of people through this page. Some got their miracle, some got the peace to walk through the hard thing — and every single one was loved out loud."
          </blockquote>
          <figcaption class="mt-4 flex items-center gap-3 text-sm text-muted">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-pine-950 font-display text-xs font-semibold text-gold-300">PB</span>
            Prayer team
          </figcaption>
        </figure>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/prayer" class="btn btn-primary btn-lg">
            <HeartHandshake class="h-5 w-5" aria-hidden="true" />
            Request Prayer
          </a>
          <a href="/ministries/prayer" class="btn btn-ghost btn-lg">Learn about the prayer team</a>
        </div>
      </Reveal>
    </div>

    <!-- Art -->
    <Reveal delay={80} class="relative order-first lg:order-last">
      <div class="absolute -right-4 -top-4 h-full w-full rounded-[2rem] border-2 border-gold-300/50" aria-hidden="true"></div>
      <img
        src={media.prayer.src}
        alt={media.prayer.alt}
        loading="lazy"
        style={{ aspectRatio: media.prayer.aspect }}
        class="img-enter relative w-full rounded-[2rem] object-cover shadow-lift"
      />
      <div class="absolute -bottom-6 left-6 rounded-3xl bg-cream px-6 py-4 shadow-lift">
        <p class="font-display text-xl font-semibold text-pine-950">"Cast all your anxiety on him"</p>
        <p class="mt-0.5 text-xs uppercase tracking-widest text-muted">1 Peter 5:7</p>
      </div>
    </Reveal>
  </div>
</section>

---
import { getCollection } from 'astro:content';
import SermonCard from '@/components/cards/SermonCard.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import { Search, SlidersHorizontal, X } from '@lucide/astro';

const sermons = (await getCollection('sermons'))
  .map((entry) => ({
    ...entry.data,
    href: `/messages/${entry.id}`,
    date: entry.data.date,
  }))
  .sort((a, b) => b.date.getTime() - a.date.getTime());

const series = [...new Set(sermons.map((s) => s.series))].sort();
const speakers = [...new Set(sermons.map((s) => s.speaker))].sort();
const years = [...new Set(sermons.map((s) => s.date.getFullYear()))].sort((a, b) => b - a);
---

<section id="archive" class="wrap py-16 lg:py-24" data-message-archive>
  <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
    <SectionHeading
      kicker="Message archive"
      title="Search the messages"
      lede={`${sermons.length} messages across ${series.length} series — search by keyword, series, speaker, or year.`}
    />
    <p class="text-sm font-medium text-muted lg:pb-2" data-result-count aria-live="polite"></p>
  </div>

  <!-- Filters -->
  <div class="mt-10 flex flex-col gap-3 rounded-[1.4rem] border border-line bg-white p-4 shadow-soft sm:flex-row sm:items-center" data-filters>
    <label class="flex flex-1 items-center gap-3 rounded-full border border-line bg-cream px-4 py-2.5 transition-colors focus-within:border-terra-500 focus-within:ring-4 focus-within:ring-terra-500/15">
      <Search class="h-4 w-4 shrink-0 text-muted" aria-hidden="true" />
      <span class="sr-only">Search messages</span>
      <input
        type="search"
        placeholder="Search titles & topics…"
        class="w-full bg-transparent text-sm text-ink outline-none placeholder:text-muted/70"
        data-filter-search
      />
    </label>

    <div class="grid grid-cols-2 gap-3 sm:flex sm:items-center">
      <label class="flex items-center gap-2 rounded-full border border-line bg-cream px-4 py-2.5 text-sm">
        <SlidersHorizontal class="h-4 w-4 shrink-0 text-muted" aria-hidden="true" />
        <span class="sr-only">Filter by series</span>
        <select class="cursor-pointer bg-transparent text-sm text-ink outline-none" data-filter-series>
          <option value="">All series</option>
          {series.map((s) => <option value={s}>{s}</option>)}
        </select>
      </label>
      <label class="flex items-center gap-2 rounded-full border border-line bg-cream px-4 py-2.5 text-sm">
        <span class="sr-only">Filter by speaker</span>
        <select class="cursor-pointer bg-transparent text-sm text-ink outline-none" data-filter-speaker>
          <option value="">All speakers</option>
          {speakers.map((s) => <option value={s}>{s}</option>)}
        </select>
      </label>
      <label class="flex items-center gap-2 rounded-full border border-line bg-cream px-4 py-2.5 text-sm">
        <span class="sr-only">Filter by year</span>
        <select class="cursor-pointer bg-transparent text-sm text-ink outline-none" data-filter-year>
          <option value="">All years</option>
          {years.map((y) => <option value={y}>{y}</option>)}
        </select>
      </label>
      <button type="button" class="btn btn-ghost btn-md text-sm" data-filter-reset hidden>
        <X class="h-4 w-4" aria-hidden="true" />
        Clear
      </button>
    </div>
  </div>

  <!-- Grid — fully server-rendered; filtering is progressive enhancement -->
  <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      sermons.map((sermon, index) => (
        <li
          data-sermon
          data-series={sermon.series}
          data-speaker={sermon.speaker}
          data-year={sermon.date.getFullYear()}
          data-search={`${sermon.title} ${sermon.description} ${sermon.scripture ?? ''}`.toLowerCase()}
          class="reveal h-full"
          style={`--reveal-delay:${(index % 3) * 70}ms`}
        >
          <SermonCard sermon={sermon} class="h-full" />
        </li>
      ))
    }
  </ul>

  <div class="mt-10" data-empty hidden>
    <EmptyState
      title="No messages found"
      lede="Try a different keyword, series, or speaker — or browse the full archive."
    >
      <button type="button" class="btn btn-primary btn-md" data-filter-reset-2>Clear filters</button>
    </EmptyState>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-message-archive]');
  if (root) {
    const search = root.querySelector<HTMLInputElement>('[data-filter-search]');
    const series = root.querySelector<HTMLSelectElement>('[data-filter-series]');
    const speaker = root.querySelector<HTMLSelectElement>('[data-filter-speaker]');
    const year = root.querySelector<HTMLSelectElement>('[data-filter-year]');
    const reset = root.querySelector<HTMLButtonElement>('[data-filter-reset]');
    const reset2 = root.querySelector<HTMLButtonElement>('[data-filter-reset-2]');
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-sermon]'));
    const empty = root.querySelector<HTMLElement>('[data-empty]');
    const count = root.querySelector<HTMLElement>('[data-result-count]');

    const state = { query: '', series: '', speaker: '', year: '' };

    const apply = () => {
      let visible = 0;
      const q = state.query.toLowerCase();
      for (const card of cards) {
        const match =
          (state.series === '' || card.dataset.series === state.series) &&
          (state.speaker === '' || card.dataset.speaker === state.speaker) &&
          (state.year === '' || card.dataset.year === state.year) &&
          (q === '' || (card.dataset.search ?? '').includes(q));
        card.hidden = !match;
        if (match) visible += 1;
      }

      const active = state.query !== '' || state.series !== '' || state.speaker !== '' || state.year !== '';
      if (reset) reset.hidden = !active;
      if (empty) empty.hidden = visible > 0;
      if (count) {
        count.textContent = active ? `${visible} of ${cards.length} messages` : '';
      }
    };

    const bind = (el: HTMLElement | null, key: keyof typeof state) => {
      el?.addEventListener('input', () => {
        if (el instanceof HTMLInputElement) state[key] = el.value.trim();
        else if (el instanceof HTMLSelectElement) state[key] = el.value;
        apply();
      });
      el?.addEventListener('change', () => {
        if (el instanceof HTMLSelectElement) state[key] = el.value;
        apply();
      });
    };

    bind(search, 'query');
    bind(series, 'series');
    bind(speaker, 'speaker');
    bind(year, 'year');

    const clear = () => {
      state.query = state.series = state.speaker = state.year = '';
      if (search) search.value = '';
      if (series) series.value = '';
      if (speaker) speaker.value = '';
      if (year) year.value = '';
      apply();
    };
    reset?.addEventListener('click', clear);
    reset2?.addEventListener('click', clear);

    apply();
  }
</script>

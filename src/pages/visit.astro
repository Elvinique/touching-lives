---
import Layout from '@/layouts/Layout.astro';
import { site } from '@/config/site';
import PageHero from '@/components/sections/PageHero.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Reveal from '@/components/ui/Reveal.astro';
import Accordion from '@/components/ui/Accordion.astro';
import MapCard from '@/components/ui/MapCard.astro';
import CTASection from '@/components/sections/CTASection.astro';
import { getNextSunday, formatLongDate } from '@/lib/dates';
import { expectations, firstVisitSteps, faqs } from '@/data/content';
import { Clock3, Sparkles, ArrowRight } from '@lucide/astro';

const nextSunday = getNextSunday();
---

<Layout
  title="Plan Your Visit"
  description="Everything you need to know before your first Sunday at Touching Lives Church — service times, location, what to expect, and what to wear."
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ]}
>
  <PageHero
    image="/art/hero-visit.svg"
    kicker="Plan your visit"
    title="We've thought of everything. You just bring you."
    lede="New to church? It's been a while? Totally new to faith? This page answers the questions most people are afraid to ask — so your first Sunday can feel easy."
  >
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
      <a href={site.mapUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
        Get Directions
        <ArrowRight class="h-4 w-4" aria-hidden="true" />
      </a>
      <a href="#faq" class="btn btn-outline-light btn-lg">Read the FAQs</a>
    </div>
  </PageHero>

  <!-- When we meet -->
  <section id="when-we-meet" class="wrap py-16 lg:py-24">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHeading
          kicker="When we meet"
          title="Two services, one welcome"
          lede="Same message, different flavor. Pick whichever fits your Sunday — or come early and stay for coffee after."
        />
        <Reveal delay={120}>
          <div class="mt-8 rounded-3xl border border-gold-300/60 bg-gold-200/30 p-6">
            <p class="flex items-center gap-2 text-sm font-semibold text-pine-900">
              <Sparkles class="h-4 w-4 text-terra-500" aria-hidden="true" />
              This week: {formatLongDate(nextSunday)}
            </p>
            <p class="mt-2 text-sm leading-relaxed text-muted">
              Kids ministry runs at both services, so parents can be fully present. Service runs about 75 minutes.
            </p>
          </div>
        </Reveal>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:col-span-7">
        {
          site.serviceTimes.map((time, index) => (
            <Reveal delay={index * 90}>
              <div class="group relative h-full overflow-hidden rounded-[1.6rem] bg-pine-950 p-8 text-cream shadow-lift transition-transform duration-300 hover:-translate-y-1">
                <span class="pointer-events-none absolute -right-10 -top-10 h-36 w-36 rounded-full bg-gold-400/15 blur-2xl" aria-hidden="true"></span>
                <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-gold-300">
                  <Clock3 class="h-4 w-4" aria-hidden="true" />
                  Sundays
                </p>
                <p class="mt-3 font-display text-5xl font-semibold">{time.label}</p>
                <p class="mt-3 text-pretty text-sm leading-relaxed text-cream/70">{time.note}</p>
              </div>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <!-- First 90 minutes -->
  <section class="bg-sand/60 py-16 lg:py-24">
    <div class="wrap">
      <SectionHeading
        kicker="Your first 90 minutes"
        title="Here's exactly what happens"
        lede="No surprises, no guesswork. Here's the whole journey from your car to your seat."
      />

      <ol class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          firstVisitSteps.map((step, index) => {
            const Icon = step.icon;
            return (
              <li class="reveal relative h-full rounded-[1.4rem] bg-white p-7 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:shadow-lift" style={`--reveal-delay:${index * 80}ms`}>
                  <span class="absolute right-6 top-6 font-display text-5xl font-semibold text-sand" aria-hidden="true">
                    {index + 1}
                  </span>
                  <span class="relative flex h-12 w-12 items-center justify-center rounded-2xl bg-terra-500/10 text-terra-600">
                    <Icon class="h-6 w-6" aria-hidden="true" />
                  </span>
                  <h3 class="relative mt-5 font-display text-xl text-ink">{step.title}</h3>
                  <p class="relative mt-2 text-pretty text-sm leading-relaxed text-muted">{step.description}</p>
                </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <!-- Where we are -->
  <section id="where-we-are" class="wrap py-16 lg:py-24">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <MapCard title="Where we are" />
      </div>
      <div class="lg:col-span-5">
        <SectionHeading
          kicker="Getting here"
          title="Easy in, easy out"
          lede="Free parking with dedicated guest spots right at the front door. Look for the red 'Guest Parking' signs."
        />
        <Reveal delay={100}>
          <ul class="mt-8 space-y-4">
            {
              [
                ['Guest parking', 'Right in front of the main entrance — no walking a parking lot in your Sunday best.'],
                ['Drop-off lane', 'Need to drop someone at the door first? The circle drive is all yours.'],
                ['Accessible entrance', 'The building is fully accessible, with elevators and an accessible drop-off zone.'],
                ['Bike & bus', 'Racks out front, and a bus stop two blocks away on Fellowship.'],
              ].map(([title, body]) => (
                <li class="flex items-start gap-4 rounded-2xl border border-line bg-white p-5 shadow-soft">
                  <span class="mt-0.5 h-2.5 w-2.5 shrink-0 rounded-full bg-terra-500" aria-hidden="true"></span>
                  <div>
                    <h3 class="font-display text-lg text-ink">{title}</h3>
                    <p class="mt-1 text-sm leading-relaxed text-muted">{body}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- What to expect -->
  <section id="what-to-expect" class="bg-sand/60 py-16 lg:py-24">
    <div class="wrap">
      <SectionHeading
        kicker="What to expect"
        title="All the things people wonder about"
        lede="The questions we hear most — answered honestly, so you don't have to worry about them on Sunday."
      />

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          expectations.map((item, index) => {
            const Icon = item.icon;
            return (
              <Reveal delay={index * 60}>
                <div class="group h-full rounded-[1.4rem] bg-white p-6 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:shadow-lift">
                  <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-pine-950 text-gold-300 transition-colors duration-300 group-hover:bg-terra-500 group-hover:text-white">
                    <Icon class="h-5 w-5" aria-hidden="true" />
                  </span>
                  <h3 class="mt-4 font-display text-lg text-ink">{item.title}</h3>
                  <p class="mt-2 text-pretty text-sm leading-relaxed text-muted">{item.description}</p>
                </div>
              </Reveal>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="wrap py-16 lg:py-24">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <SectionHeading
          kicker="Good questions"
          title="Still wondering about something?"
          lede="If it's not answered here, just ask — we answer every message."
        />
        <Reveal delay={120}>
          <a href="/contact" class="btn btn-primary btn-md mt-8">Ask us anything</a>
        </Reveal>
      </div>
      <div class="lg:col-span-8">
        <Reveal delay={80}>
          <Accordion items={faqs} />
        </Reveal>
      </div>
    </div>
  </section>

  <CTASection
    kicker="First-timer friendly"
    title="We saved you a seat."
    lede="Plan to arrive 15 minutes early, look for the guest parking, and tell the welcome team it's your first time — they'll take care of the rest."
    primary={{ label: 'Get Directions', href: site.mapUrl }}
    secondary={{ label: 'Questions? Contact us', href: '/contact' }}
  />
</Layout>

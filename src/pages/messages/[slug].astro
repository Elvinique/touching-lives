---
import Layout from '@/layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import SermonCard from '@/components/cards/SermonCard.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Reveal from '@/components/ui/Reveal.astro';
import { formatLongDate } from '@/lib/dates';
import { site } from '@/config/site';
import { Play, User, CalendarDays, BookOpen, Clock3, ArrowRight, Mail } from '@lucide/astro';

export async function getStaticPaths() {
  const sermons = await getCollection('sermons');
  return sermons
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
    .map((sermon) => ({ params: { slug: sermon.id }, props: { sermon } }));
}

const { sermon } = Astro.props;
const { Content } = await render(sermon);

const seriesSermons = (await getCollection('sermons'))
  .filter((s) => s.data.series === sermon.data.series)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const currentIndex = seriesSermons.findIndex((s) => s.id === sermon.id);
const prev = currentIndex > 0 ? seriesSermons[currentIndex - 1] : null;
const next = currentIndex < seriesSermons.length - 1 ? seriesSermons[currentIndex + 1] : null;
const related = seriesSermons.filter((s) => s.id !== sermon.id).slice(0, 3);

const playHref = (sermon.data.videoUrl ?? site.youtubeChannel) || '';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  headline: sermon.data.title,
  description: sermon.data.description,
  datePublished: sermon.data.date.toISOString(),
  author: { '@type': 'Person', name: sermon.data.speaker },
  publisher: { '@type': 'Organization', name: site.legalName },
  isPartOf: { '@type': 'CreativeWorkSeries', name: sermon.data.series },
};
---

<Layout
  title={sermon.data.title}
  description={sermon.data.description}
  type="article"
  image={sermon.data.image}
  jsonLd={[jsonLd]}
>
  <!-- Message hero -->
  <section class="relative overflow-hidden bg-pine-950">
    <img
      src={sermon.data.image}
      alt=""
      class="absolute inset-0 h-full w-full object-cover opacity-30"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-pine-950/85 via-pine-950/60 to-pine-950" aria-hidden="true"></div>

    <div class="wrap relative pb-14 pt-32 lg:pt-40">
      <Breadcrumbs
        items={[
          { label: 'Messages', href: '/messages' },
          { label: sermon.data.series },
          { label: sermon.data.title },
        ]}
      />

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <span class="chip chip-gold">{sermon.data.series}</span>
        {
          sermon.data.duration && (
            <span class="chip chip-dark">
              <Clock3 class="h-3 w-3" aria-hidden="true" />
              {sermon.data.duration}
            </span>
          )
        }
      </div>

      <h1 class="hero-rise mt-5 max-w-3xl font-display text-hero text-balance text-cream" style="--d:80ms">
        {sermon.data.title}
      </h1>

      <p class="hero-rise meta mt-6" style="--d:150ms">
        <span class="text-cream/75"><User aria-hidden="true" />{sermon.data.speaker}</span>
        <span class="text-cream/75"><CalendarDays aria-hidden="true" />{formatLongDate(sermon.data.date)}</span>
        {sermon.data.scripture && (
          <span class="text-cream/75"><BookOpen aria-hidden="true" />{sermon.data.scripture}</span>
        )}
      </p>
    </div>
  </section>

  <!-- Media + body -->
  <section class="wrap py-14 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-8">
        <Reveal>
          <div class="group relative aspect-video overflow-hidden rounded-[1.6rem] shadow-lift">
            <img
              src={sermon.data.image}
              alt=""
              loading="lazy"
              class="h-full w-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-pine-950/80 via-transparent to-transparent" aria-hidden="true"></div>

            {
              playHref ? (
                <a
                  href={playHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="absolute inset-0 m-auto flex h-20 w-20 items-center justify-center rounded-full bg-terra-500 text-white shadow-glow transition-transform duration-300 hover:scale-110"
                  aria-label={`Watch ${sermon.data.title} online`}
                >
                  <Play class="ml-1 h-8 w-8 fill-current" aria-hidden="true" />
                </a>
              ) : (
                <div class="absolute inset-0 flex items-center justify-center">
                  <span class="chip chip-dark text-sm">
                    Video available on our channel soon
                  </span>
                </div>
              )
            }
          </div>
        </Reveal>

        <Reveal delay={100}>
          <p class="mt-8 text-pretty text-lg leading-relaxed text-pine-950/80">{sermon.data.description}</p>
        </Reveal>

        <Reveal delay={140}>
          <article class="rich mt-10 border-t border-line pt-10">
            <Content />
          </article>
        </Reveal>
      </div>

      <!-- Sidebar -->
      <aside class="lg:col-span-4">
        <div class="sticky top-24 space-y-6">
          <Reveal>
            <div class="rounded-[1.6rem] border border-line bg-white p-7 shadow-soft">
              <h2 class="font-display text-xl text-ink">About this message</h2>
              <dl class="mt-5 space-y-4 text-sm">
                <div class="flex justify-between gap-4">
                  <dt class="text-muted">Series</dt>
                  <dd class="text-right font-medium text-ink">{sermon.data.series}</dd>
                </div>
                <div class="flex justify-between gap-4">
                  <dt class="text-muted">Speaker</dt>
                  <dd class="text-right font-medium text-ink">{sermon.data.speaker}</dd>
                </div>
                <div class="flex justify-between gap-4">
                  <dt class="text-muted">Date</dt>
                  <dd class="text-right font-medium text-ink">{formatLongDate(sermon.data.date)}</dd>
                </div>
                {
                  sermon.data.scripture && (
                    <div class="flex justify-between gap-4">
                      <dt class="text-muted">Scripture</dt>
                      <dd class="text-right font-medium text-ink">{sermon.data.scripture}</dd>
                    </div>
                  )
                }
                {
                  sermon.data.duration && (
                    <div class="flex justify-between gap-4">
                      <dt class="text-muted">Duration</dt>
                      <dd class="text-right font-medium text-ink">{sermon.data.duration}</dd>
                    </div>
                  )
                }
              </dl>
            </div>
          </Reveal>

          <Reveal delay={80}>
            <div class="rounded-[1.6rem] bg-pine-950 p-7 text-cream shadow-lift">
              <h2 class="font-display text-xl">Been stirred by this message?</h2>
              <p class="mt-2 text-pretty text-sm leading-relaxed text-cream/70">
                We'd love to pray with you about what it brought up, or help you take a next step.
              </p>
              <div class="mt-5 flex flex-col gap-3">
                <a href="/prayer" class="btn btn-primary btn-md">Request prayer</a>
                <a href="/contact" class="btn btn-outline-light btn-md">
                  <Mail class="h-4 w-4" aria-hidden="true" />
                  Contact us
                </a>
              </div>
            </div>
          </Reveal>
        </div>
      </aside>
    </div>

    <!-- Series navigation -->
    <nav class="mt-14 grid gap-4 sm:grid-cols-2" aria-label="Series navigation">
      {prev ? (
        <a
          href={`/messages/${prev.id}`}
          class="group flex items-center justify-between gap-4 rounded-2xl border border-line bg-white p-5 shadow-soft transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lift"
        >
          <span>
            <span class="text-xs font-semibold uppercase tracking-widest text-muted">← Previous in series</span>
            <span class="mt-1 block font-display text-lg text-ink">{prev.data.title}</span>
          </span>
        </a>
      ) : (
        <span></span>
      )}
      {
        next && (
          <a
            href={`/messages/${next.id}`}
            class="group flex items-center justify-between gap-4 rounded-2xl border border-line bg-white p-5 text-right shadow-soft transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lift"
          >
            <span class="ml-auto">
              <span class="block text-xs font-semibold uppercase tracking-widest text-muted">Next in series →</span>
              <span class="mt-1 block font-display text-lg text-ink">{next.data.title}</span>
            </span>
          </a>
        )
      }
    </nav>
  </section>

  <!-- Related -->
  {
    related.length > 0 && (
      <section class="bg-sand/60 py-16 lg:py-20">
        <div class="wrap">
          <SectionHeading
            kicker="Keep listening"
            title={`More from ${sermon.data.series}`}
          />
          <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {
              related.map((item) => (
                <li class="h-full">
                  <SermonCard
                    sermon={{
                      title: item.data.title,
                      series: item.data.series,
                      speaker: item.data.speaker,
                      date: item.data.date,
                      scripture: item.data.scripture,
                      duration: item.data.duration,
                      description: item.data.description,
                      image: item.data.image,
                      href: `/messages/${item.id}`,
                      videoUrl: item.data.videoUrl,
                    }}
                    class="h-full"
                  />
                </li>
              ))
            }
          </ul>
          <Reveal delay={80}>
            <div class="mt-10 text-center">
              <a href="/messages" class="btn btn-outline btn-lg">
                Explore all messages
                <ArrowRight class="h-4 w-4" aria-hidden="true" />
              </a>
            </div>
          </Reveal>
        </div>
      </section>
    )
  }
</Layout>

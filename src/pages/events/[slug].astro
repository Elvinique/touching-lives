---
import Layout from '@/layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import EventCard from '@/components/cards/EventCard.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Reveal from '@/components/ui/Reveal.astro';
import { formatLongDate, isUpcoming, googleCalendarUrl } from '@/lib/dates';
import { CalendarDays, Clock3, MapPin, Ticket, ArrowRight } from '@lucide/astro';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}

const { event } = Astro.props;
const { Content } = await render(event);

const start = event.data.date;
const end = event.data.endDate ?? event.data.date;
const calUrl = googleCalendarUrl(event.data.title, start, end, event.data.location, event.data.description);

const registrationExternal = !!event.data.registrationUrl?.startsWith('http');

const moreEvents = (await getCollection('events'))
  .filter((e) => e.id !== event.id && isUpcoming(e.data.date))
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.data.title,
  description: event.data.description,
  startDate: event.data.date.toISOString(),
  ...(event.data.endDate ? { endDate: event.data.endDate.toISOString() } : {}),
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: { '@type': 'Place', name: event.data.location },
  organizer: { '@type': 'Organization', name: 'Touching Lives Church' },
};
---

<Layout
  title={event.data.title}
  description={event.data.description}
  type="article"
  image={event.data.image}
  jsonLd={[jsonLd]}
>
  <!-- Event hero -->
  <section class="relative overflow-hidden bg-pine-950">
    <img
      src={event.data.image}
      alt=""
      class="absolute inset-0 h-full w-full object-cover opacity-35"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-pine-950/85 via-pine-950/60 to-pine-950" aria-hidden="true"></div>

    <div class="wrap relative pb-14 pt-32 lg:pt-40">
      <Breadcrumbs
        items={[
          { label: 'Events', href: '/events' },
          { label: event.data.category },
          { label: event.data.title },
        ]}
      />

      <span class="chip chip-gold mt-6">{event.data.category}</span>
      <h1 class="hero-rise mt-5 max-w-3xl font-display text-hero text-balance text-cream" style="--d:80ms">
        {event.data.title}
      </h1>

      <div class="hero-rise mt-7 flex flex-wrap gap-x-6 gap-y-3 text-sm text-cream/80" style="--d:150ms">
        <span class="inline-flex items-center gap-2">
          <CalendarDays class="h-4 w-4 text-gold-300" aria-hidden="true" />
          {formatLongDate(event.data.date)}
        </span>
        <span class="inline-flex items-center gap-2">
          <Clock3 class="h-4 w-4 text-gold-300" aria-hidden="true" />
          {event.data.time}
        </span>
        <span class="inline-flex items-center gap-2">
          <MapPin class="h-4 w-4 text-gold-300" aria-hidden="true" />
          {event.data.location}
        </span>
      </div>
    </div>
  </section>

  <section class="wrap py-14 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-8">
        <Reveal>
          <img
            src={event.data.image}
            alt={`${event.data.title} — ${event.data.category}`}
            loading="lazy"
            class="aspect-video w-full rounded-[1.6rem] object-cover shadow-lift"
          />
        </Reveal>

        <Reveal delay={80}>
          <article class="rich mt-10">
            <Content />
          </article>
        </Reveal>
      </div>

      <aside class="lg:col-span-4">
        <div class="sticky top-24 space-y-6">
          <Reveal>
            <div class="rounded-[1.6rem] border border-line bg-white p-7 shadow-soft">
              <h2 class="font-display text-xl text-ink">Event details</h2>
              <dl class="mt-5 space-y-4 text-sm">
                <div class="flex justify-between gap-4">
                  <dt class="text-muted">Date</dt>
                  <dd class="text-right font-medium text-ink">{formatLongDate(event.data.date)}</dd>
                </div>
                <div class="flex justify-between gap-4">
                  <dt class="text-muted">Time</dt>
                  <dd class="text-right font-medium text-ink">{event.data.time}</dd>
                </div>
                <div class="flex justify-between gap-4">
                  <dt class="text-muted">Location</dt>
                  <dd class="text-right font-medium text-ink">{event.data.location}</dd>
                </div>
                <div class="flex justify-between gap-4">
                  <dt class="text-muted">Category</dt>
                  <dd class="text-right font-medium text-ink">{event.data.category}</dd>
                </div>
              </dl>

              <div class="mt-7 flex flex-col gap-3">
                {
                  event.data.registrationUrl && (
                    <a
                      href={event.data.registrationUrl}
                      target={registrationExternal ? '_blank' : undefined}
                      rel={registrationExternal ? 'noopener noreferrer' : undefined}
                      class="btn btn-primary btn-lg"
                    >
                      <Ticket class="h-5 w-5" aria-hidden="true" />
                      Register / RSVP
                    </a>
                  )
                }
                <a href={calUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-md">
                  <CalendarDays class="h-4 w-4" aria-hidden="true" />
                  Add to calendar
                </a>
              </div>
            </div>
          </Reveal>

          <Reveal delay={80}>
            <div class="rounded-[1.6rem] bg-pine-950 p-7 text-cream shadow-lift">
              <h2 class="font-display text-xl">Bringing someone?</h2>
              <p class="mt-2 text-pretty text-sm leading-relaxed text-cream/70">
                Most of our events are free and open to everyone. If you have questions about what to expect, we're happy to answer.
              </p>
              <a href="/contact" class="btn btn-outline-light btn-md mt-5">Ask a question</a>
            </div>
          </Reveal>
        </div>
      </aside>
    </div>
  </section>

  {
    moreEvents.length > 0 && (
      <section class="bg-sand/60 py-16 lg:py-20">
        <div class="wrap">
          <SectionHeading kicker="More to come" title="Other upcoming events" />
          <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {
              moreEvents.map((item) => (
                <li class="h-full">
                  <EventCard
                    event={{
                      title: item.data.title,
                      date: item.data.date,
                      time: item.data.time,
                      location: item.data.location,
                      category: item.data.category,
                      description: item.data.description,
                      image: item.data.image,
                      href: `/events/${item.id}`,
                    }}
                    class="h-full"
                  />
                </li>
              ))
            }
          </ul>
          <Reveal delay={80}>
            <div class="mt-10 text-center">
              <a href="/events" class="btn btn-outline btn-lg">
                View all events
                <ArrowRight class="h-4 w-4" aria-hidden="true" />
              </a>
            </div>
          </Reveal>
        </div>
      </section>
    )
  }
</Layout>

---
import Layout from '@/layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import MinistryCard from '@/components/cards/MinistryCard.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Reveal from '@/components/ui/Reveal.astro';
import { site } from '@/config/site';
import { Users, CalendarClock, UserRound, Mail, ArrowRight, Sparkles } from '@lucide/astro';

export async function getStaticPaths() {
  const ministries = await getCollection('ministries');
  return ministries.map((ministry) => ({ params: { slug: ministry.id }, props: { ministry } }));
}

const { ministry } = Astro.props;
const { Content } = await render(ministry);

const others = (await getCollection('ministries'))
  .filter((m) => m.id !== ministry.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const joinHref = ministry.data.leader
  ? `mailto:${site.email}?subject=${encodeURIComponent(`Getting involved: ${ministry.data.title}`)}`
  : '/contact';
---

<Layout
  title={ministry.data.title}
  description={ministry.data.tagline}
  type="article"
  image={ministry.data.image}
>
  <!-- Ministry hero -->
  <section class="relative overflow-hidden bg-pine-950">
    <img
      src={ministry.data.image}
      alt=""
      class="absolute inset-0 h-full w-full object-cover opacity-35"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-pine-950/85 via-pine-950/60 to-pine-950" aria-hidden="true"></div>

    <div class="wrap relative pb-14 pt-32 lg:pt-40">
      <Breadcrumbs
        items={[
          { label: 'Ministries', href: '/ministries' },
          { label: ministry.data.title },
        ]}
      />

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <span class="chip chip-dark">
          <Users class="h-3 w-3" aria-hidden="true" />
          {ministry.data.audience}
        </span>
      </div>

      <h1 class="hero-rise mt-5 max-w-3xl font-display text-hero text-balance text-cream" style="--d:80ms">
        {ministry.data.title}
      </h1>

      <p class="hero-rise mt-5 max-w-2xl font-display text-xl text-gold-200" style="--d:150ms">
        {ministry.data.tagline}
      </p>
    </div>
  </section>

  <section class="wrap py-14 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-8">
        <Reveal>
          <img
            src={ministry.data.image}
            alt={ministry.data.title}
            loading="lazy"
            class="aspect-video w-full rounded-[1.6rem] object-cover shadow-lift"
          />
        </Reveal>

        <Reveal delay={80}>
          <article class="rich mt-10">
            <Content />
          </article>
        </Reveal>
      </div>

      <aside class="lg:col-span-4">
        <div class="sticky top-24 space-y-6">
          <Reveal>
            <div class="rounded-[1.6rem] border border-line bg-white p-7 shadow-soft">
              <h2 class="font-display text-xl text-ink">Ministry details</h2>
              <dl class="mt-5 space-y-4 text-sm">
                <div class="flex justify-between gap-4">
                  <dt class="text-muted">Who it's for</dt>
                  <dd class="text-right font-medium text-ink">{ministry.data.audience}</dd>
                </div>
                {
                  ministry.data.meets && (
                    <div class="flex justify-between gap-4">
                      <dt class="flex items-center gap-2 text-muted">
                        <CalendarClock class="h-4 w-4" aria-hidden="true" />
                        When
                      </dt>
                      <dd class="text-right font-medium text-ink">{ministry.data.meets}</dd>
                    </div>
                  )
                }
                {
                  ministry.data.leader && (
                    <div class="flex justify-between gap-4">
                      <dt class="flex items-center gap-2 text-muted">
                        <UserRound class="h-4 w-4" aria-hidden="true" />
                        Leader
                      </dt>
                      <dd class="text-right font-medium text-ink">{ministry.data.leader}</dd>
                    </div>
                  )
                }
              </dl>

              <div class="mt-7 flex flex-col gap-3">
                <a href={joinHref} class="btn btn-primary btn-lg">
                  <Mail class="h-5 w-5" aria-hidden="true" />
                  Get involved
                </a>
                <a href="/visit" class="btn btn-outline btn-md">Visit on a Sunday</a>
              </div>
            </div>
          </Reveal>

          <Reveal delay={80}>
            <div class="rounded-[1.6rem] bg-pine-950 p-7 text-cream shadow-lift">
              <p class="flex items-start gap-3 text-sm leading-relaxed text-cream/75">
                <Sparkles class="mt-0.5 h-5 w-5 shrink-0 text-gold-300" aria-hidden="true" />
                New here? Come check out {ministry.data.title} as a guest first — no sign-up, no commitment, just showing up.
              </p>
            </div>
          </Reveal>
        </div>
      </aside>
    </div>
  </section>

  {
    others.length > 0 && (
      <section class="bg-sand/60 py-16 lg:py-20">
        <div class="wrap">
          <SectionHeading kicker="Keep exploring" title="Other ministries" />
          <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {
              others.map((item) => (
                <li class="h-full">
                  <MinistryCard
                    ministry={{
                      title: item.data.title,
                      tagline: item.data.tagline,
                      audience: item.data.audience,
                      image: item.data.image,
                      href: `/ministries/${item.id}`,
                    }}
                  />
                </li>
              ))
            }
          </ul>
          <Reveal delay={80}>
            <div class="mt-10 text-center">
              <a href="/ministries" class="btn btn-outline btn-lg">
                View all ministries
                <ArrowRight class="h-4 w-4" aria-hidden="true" />
              </a>
            </div>
          </Reveal>
        </div>
      </section>
    )
  }
</Layout>

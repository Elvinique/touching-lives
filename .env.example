# Copy this file to .env.local and fill in the values.
# All variables are optional — the site falls back to the placeholders in src/config/site.ts.

# Production domain (used for canonical URLs, sitemap, and Open Graph)
PUBLIC_SITE_URL=https://your-domain.pages.dev

# YouTube channel URL (enables "Watch Online" links + YouTube social icon)
PUBLIC_YOUTUBE_URL=https://youtube.com/@yourchannel

# External giving link (enables the "Give Online" button on /give)
PUBLIC_GIVING_URL=https://your-giving-provider.example/yourchurch

# Google Maps link for "Get Directions" buttons
PUBLIC_GOOGLE_MAPS_URL=https://www.google.com/maps/search/?api=1&query=...

# Form delivery endpoints — any JSON form backend (e.g. a free Formspree/Basin endpoint).
# Until set, forms validate locally and show an honest "not connected" notice.
PUBLIC_PRAYER_ENDPOINT=
PUBLIC_CONTACT_ENDPOINT=
PUBLIC_NEWSLETTER_ENDPOINT=
